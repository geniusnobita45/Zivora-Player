{
  "name": "zivora-ai-player",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:audit": "node --import tsx scripts/bundle-audit.ts",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "media:process": "tsx pipeline/media/process.ts",
    "media:validate": "tsx pipeline/validation/MediaValidator.ts",
    "db:migration:build": "tsx database/migrations/build.ts",
    "media:publish": "node --import tsx pipeline/publish/cli.ts publish",
    "media:rollback": "node --import tsx pipeline/publish/cli.ts rollback",
    "ingest": "node --import tsx scripts/zivora-ingest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "idb": "8.0.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "shaka-player": "^4.16.48",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.20.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
